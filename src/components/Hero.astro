---
import { personalInfo } from '../data/portfolio';
---

<section class="relative pt-24 pb-20 md:pt-32 md:pb-28 overflow-hidden">
  <!-- Subtle gradient background blur spot -->
  <div class="absolute top-1/4 left-1/2 -translate-x-1/2 -translate-y-1/2 w-96 h-96 bg-indigo-500/10 rounded-full blur-3xl -z-10"></div>
  
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 text-center md:text-left flex flex-col md:flex-row items-center justify-between gap-12">
    <div class="flex-1 space-y-6">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-indigo-500/10 border border-indigo-500/20 text-indigo-400 text-xs font-semibold uppercase tracking-wider">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span> Available for Local SEO & Web Design Projects
      </div>
      
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white tracking-tight leading-tight">
        Hi, I'm <span class="bg-gradient-to-r from-indigo-400 via-sky-400 to-emerald-400 bg-clip-text text-transparent">{personalInfo.name}</span>
      </h1>
      
      <p class="text-xl sm:text-2xl text-slate-300 font-medium">
        {personalInfo.role}
      </p>

      <p class="text-base text-slate-400 max-w-2xl leading-relaxed">
        {personalInfo.bio}
      </p>

      <!-- Services pills -->
      <div class="flex flex-wrap gap-2 pt-1 justify-center md:justify-start">
        <span class="px-3 py-1 text-xs font-medium rounded-full bg-slate-800 border border-slate-700 text-indigo-300">📍 Local SEO & GMB</span>
        <span class="px-3 py-1 text-xs font-medium rounded-full bg-slate-800 border border-slate-700 text-sky-300">🎨 WordPress & Elementor</span>
        <span class="px-3 py-1 text-xs font-medium rounded-full bg-slate-800 border border-slate-700 text-emerald-300">✨ Squarespace & Custom Code</span>
      </div>

      <div class="flex flex-wrap items-center justify-center md:justify-start gap-4 pt-4">
        <a
          href="#services"
          class="px-6 py-3 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white font-medium shadow-lg shadow-indigo-600/25 transition-all hover:scale-105"
        >
          Explore Services
        </a>
        <a
          href="#contact"
          class="px-6 py-3 rounded-lg border border-slate-700 hover:border-slate-500 bg-slate-800/50 hover:bg-slate-800 text-slate-200 font-medium transition-all"
        >
          Get Free GMB Audit
        </a>
      </div>
    </div>

    <!-- Hero Card Graphic -->
    <div class="w-full max-w-sm md:w-auto flex-1 flex justify-center">
      <div class="relative p-1 rounded-2xl bg-gradient-to-b from-indigo-500 via-sky-500 to-transparent shadow-2xl">
        <div class="bg-slate-900 rounded-[14px] p-6 space-y-4 border border-slate-800">
          <div class="flex items-center justify-between border-b border-slate-800 pb-3">
            <div class="flex items-center space-x-2">
              <div class="w-3 h-3 rounded-full bg-rose-500"></div>
              <div class="w-3 h-3 rounded-full bg-amber-500"></div>
              <div class="w-3 h-3 rounded-full bg-emerald-500"></div>
            </div>
            <span class="text-xs text-emerald-400 font-semibold bg-emerald-500/10 px-2 py-0.5 rounded border border-emerald-500/20">Google Map Pack #1</span>
          </div>

          <div class="space-y-3">
            <div class="p-3 bg-slate-950/80 rounded-lg border border-slate-800">
              <div class="text-xs text-slate-400">Target Keyword</div>
              <div class="text-sm font-semibold text-white">"Best Local Service Near Me"</div>
            </div>

            <div class="p-3 bg-slate-950/80 rounded-lg border border-slate-800 space-y-2">
              <div class="flex justify-between items-center text-xs">
                <span class="text-slate-400">GMB Audit Score</span>
                <span class="text-emerald-400 font-bold">98 / 100</span>
              </div>
              <div class="w-full bg-slate-800 h-1.5 rounded-full overflow-hidden">
                <div class="bg-emerald-400 h-full w-[98%]"></div>
              </div>
            </div>

            <div class="grid grid-cols-2 gap-2 text-center text-xs">
              <div class="p-2 bg-indigo-500/10 rounded border border-indigo-500/20 text-indigo-300 font-medium">
                WordPress & Elementor
              </div>
              <div class="p-2 bg-sky-500/10 rounded border border-sky-500/20 text-sky-300 font-medium">
                Squarespace & Custom
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
