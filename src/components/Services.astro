---
import { services } from '../data/portfolio';
---

<section id="services" class="py-20 bg-slate-900/60 border-t border-b border-slate-800 relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-16">
      <span class="text-xs font-semibold uppercase tracking-wider text-indigo-400 bg-indigo-500/10 border border-indigo-500/20 px-3 py-1 rounded-full">
        Services & Solutions
      </span>
      <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight mt-4">
        Local SEO & Web Design Services
      </h2>
      <p class="mt-4 text-slate-400 max-w-2xl mx-auto text-base">
        From ranking #1 on Google Maps to designing high-converting websites on WordPress, Elementor, Squarespace, or custom code — here is how I help your business grow.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      {services.map((service) => (
        <div class="flex flex-col bg-slate-800/40 border border-slate-800 hover:border-indigo-500/40 rounded-2xl p-6 transition-all hover:-translate-y-1 shadow-lg shadow-slate-950/30">
          <div class="w-12 h-12 rounded-xl bg-indigo-500/10 border border-indigo-500/20 flex items-center justify-center text-2xl mb-6">
            {service.icon}
          </div>

          <h3 class="text-xl font-bold text-white mb-3 leading-snug">
            {service.title}
          </h3>

          <p class="text-slate-400 text-sm mb-6 leading-relaxed flex-grow">
            {service.description}
          </p>

          <ul class="space-y-2.5 pt-4 border-t border-slate-800/80">
            {service.features.map((feature) => (
              <li class="flex items-start text-xs text-slate-300">
                <span class="text-indigo-400 mr-2 font-bold">✓</span>
                <span>{feature}</span>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>

    <div class="mt-16 text-center bg-gradient-to-r from-indigo-950/60 via-slate-900 to-indigo-950/60 p-8 rounded-2xl border border-indigo-500/20">
      <h3 class="text-xl font-bold text-white mb-2">Need a Custom GMB Audit or Web Redesign?</h3>
      <p class="text-slate-400 text-sm max-w-xl mx-auto mb-6">
        Let's analyze your local search rankings and website performance to build a customized growth action plan.
      </p>
      <a
        href="#contact"
        class="inline-flex items-center px-6 py-3 rounded-lg bg-indigo-600 hover:bg-indigo-500 text-white font-medium shadow-lg shadow-indigo-600/25 transition-all"
      >
        Request Free Local SEO & GMB Audit ↗
      </a>
    </div>
  </div>
</section>

