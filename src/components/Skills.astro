---
import { skills } from '../data/portfolio';
---

<section id="skills" class="py-20 bg-slate-900/50 border-t border-b border-slate-800">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-14">
      <h2 class="text-3xl sm:text-4xl font-bold text-white tracking-tight">Skills & Tech Stack</h2>
      <p class="mt-4 text-slate-400 max-w-2xl mx-auto">
        Technologies, frameworks, and tools I use to bring ideas to life.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {skills.map((category) => (
        <div class="bg-slate-800/40 p-6 rounded-xl border border-slate-800 space-y-4">
          <h3 class="text-lg font-bold text-indigo-400 tracking-wide">{category.name}</h3>
          
          <div class="flex flex-wrap gap-2.5">
            {category.skills.map((skill) => (
              <span class="px-3 py-1.5 rounded-lg bg-slate-900/90 text-slate-200 text-sm font-medium border border-slate-700/60 hover:border-indigo-500/50 transition-colors">
                {skill}
              </span>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

